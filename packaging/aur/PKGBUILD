# Maintainer: Galaxoid Labs <ismyhc@gmail.com>

pkgname=sieve
pkgver=0.1.0
pkgrel=1
pkgdesc="A privacy-focused Bitcoin wallet that syncs with compact block filters"
arch=('x86_64' 'aarch64')
url="https://github.com/Galaxoid-Labs/sieve"
license=('MIT')
# Printed after `pacman -R sieve`, and it prints rather than deletes: removing
# the package leaves every wallet where it is, which is correct for a wallet
# and useless if nobody is told where that is. See sieve.install.
install=sieve.install
# GTK 4 and libadwaita are the interface; sqlite holds public descriptors and
# transaction history; openssl is used by the HTTP client for prices and fees.
# systemd-libs is libudev, which the hardware-signer support links through
# async-hwi. It is installed on any Arch system, which is exactly why leaving
# it out went unnoticed: the package built here and would have built anywhere.
depends=('gtk4' 'libadwaita' 'sqlite' 'openssl' 'systemd-libs')
makedepends=('cargo' 'git')
# Sieve looks for tor on PATH as well as beside its own binary, so a system
# Tor is all that is needed to route connections through it.
optdepends=('tor: route every connection through Tor')
# makepkg compiles C with -flto=auto by default (OPTIONS=(... lto) in
# makepkg.conf). secp256k1 ships a bundled C library, and building it to LLVM
# bitcode leaves rust-lld unable to resolve rustsecp256k1_* at link time:
#
#   rust-lld: error: undefined symbol: rustsecp256k1_v0_10_0_ec_pubkey_parse
#
# Rust's own LTO is unaffected and stays on — `cargo build --release` links
# perfectly well outside makepkg. This switches off the *C* LTO that makepkg
# adds, which is the standard measure for a Rust package with a C dependency.
#
# `!debug` because makepkg's default OPTIONS now include `debug`, which splits
# a `sieve-debug` package off beside the real one. Here it comes out *empty* —
# the release profile carries no debug info to move — so it is a second package
# that costs a second upload and says nothing. It also broke the release
# workflow, which globbed `*.pkg.tar.zst` expecting one file and handed bsdtar
# two: the first was read as the archive and the second as a member to find
# inside it.
options=(!lto !debug)
# GitHub's generated tarball, which is what this points at, is produced on
# demand and has changed bytes before — which is why the release attaches a
# tarball of its own and why the PKGBUILD published to the AUR must point at
# that one, with the checksum the release computed for it.
#
# SKIP is tolerable *here* and nowhere else: CI builds this PKGBUILD against a
# `git archive` of the commit under test, placed beside it, so there is no
# download to verify. A SKIP in the published PKGBUILD would mean every AUR
# user accepting whatever the URL serves them, which is the whole thing a
# checksum is for.
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  # Vendor everything the lock file names, so build() needs no network and
  # resolves to exactly the versions that were tested.
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # Needs no network and no display: the tests that do are marked ignored.
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm0755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"

  install -Dm0644 "data/com.galaxoidlabs.Sieve.desktop" \
    "$pkgdir/usr/share/applications/com.galaxoidlabs.Sieve.desktop"

  # The icon is compiled into the binary as a gresource for the app's own use,
  # which does nothing for the desktop's icon theme: the desktop entry asks for
  # `com.galaxoidlabs.Sieve`, and that name has to exist on disk under hicolor.
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm0644 "data/icons/hicolor/${size}x${size}/apps/com.galaxoidlabs.Sieve.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/com.galaxoidlabs.Sieve.png"
  done

  # Without these a hardware signer is visible only to root, which is the whole
  # of "it is plugged in and nothing happens" on Linux.
  install -Dm0644 "packaging/udev/51-sieve-hardware.rules" \
    "$pkgdir/usr/lib/udev/rules.d/51-sieve-hardware.rules"

  # MIT is not one of the licences Arch keeps a shared copy of, so a package
  # under it has to ship the text itself.
  install -Dm0644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -Dm0644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm0644 "SECURITY.md" "$pkgdir/usr/share/doc/$pkgname/SECURITY.md"
}

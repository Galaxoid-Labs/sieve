<?xml version="1.0" encoding="UTF-8"?>
<!-- Compiled into the binary at build time, so the icons are available with no
     filesystem path. GTK searches resource://{app-id-path}/icons, so the
     prefix has to be exactly that, and each file needs an alias — without one
     the resource path is the prefix plus the file's own path, which buries the
     icon several directories below where GTK looks. -->
<gresources>
  <gresource prefix="/com/galaxoidlabs/Sieve/icons/scalable/actions">
    <file preprocess="xml-stripblanks" alias="sieve-receive-symbolic.svg">icons/hicolor/scalable/actions/sieve-receive-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="sieve-send-symbolic.svg">icons/hicolor/scalable/actions/sieve-send-symbolic.svg</file>
  </gresource>
  <!-- Sieve's own icon, at the sizes the theme looks for. Compiled in as well
       as installed by the package: a build run straight from the source tree
       has no hicolor directory to find it in, and an app whose own About
       window shows a broken image looks broken. -->
  <gresource prefix="/com/galaxoidlabs/Sieve/icons/16x16/apps">
    <file alias="com.galaxoidlabs.Sieve.png">icons/hicolor/16x16/apps/com.galaxoidlabs.Sieve.png</file>
  </gresource>
  <gresource prefix="/com/galaxoidlabs/Sieve/icons/24x24/apps">
    <file alias="com.galaxoidlabs.Sieve.png">icons/hicolor/24x24/apps/com.galaxoidlabs.Sieve.png</file>
  </gresource>
  <gresource prefix="/com/galaxoidlabs/Sieve/icons/32x32/apps">
    <file alias="com.galaxoidlabs.Sieve.png">icons/hicolor/32x32/apps/com.galaxoidlabs.Sieve.png</file>
  </gresource>
  <gresource prefix="/com/galaxoidlabs/Sieve/icons/48x48/apps">
    <file alias="com.galaxoidlabs.Sieve.png">icons/hicolor/48x48/apps/com.galaxoidlabs.Sieve.png</file>
  </gresource>
  <gresource prefix="/com/galaxoidlabs/Sieve/icons/64x64/apps">
    <file alias="com.galaxoidlabs.Sieve.png">icons/hicolor/64x64/apps/com.galaxoidlabs.Sieve.png</file>
  </gresource>
  <gresource prefix="/com/galaxoidlabs/Sieve/icons/128x128/apps">
    <file alias="com.galaxoidlabs.Sieve.png">icons/hicolor/128x128/apps/com.galaxoidlabs.Sieve.png</file>
  </gresource>
  <gresource prefix="/com/galaxoidlabs/Sieve/icons/256x256/apps">
    <file alias="com.galaxoidlabs.Sieve.png">icons/hicolor/256x256/apps/com.galaxoidlabs.Sieve.png</file>
  </gresource>
  <gresource prefix="/com/galaxoidlabs/Sieve/icons/512x512/apps">
    <file alias="com.galaxoidlabs.Sieve.png">icons/hicolor/512x512/apps/com.galaxoidlabs.Sieve.png</file>
  </gresource>
</gresources>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Compiled into the binary at build time, so the icons are available with no
     filesystem path. GTK searches resource://{app-id-path}/icons, so the
     prefix has to be exactly that, and each file needs an alias — without one
     the resource path is the prefix plus the file's own path, which buries the
     icon several directories below where GTK looks. -->
<gresources>
  <gresource prefix="/com/galaxoidlabs/Sieve/icons/scalable/actions">
    <file preprocess="xml-stripblanks" alias="sieve-receive-symbolic.svg">icons/hicolor/scalable/actions/sieve-receive-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="sieve-send-symbolic.svg">icons/hicolor/scalable/actions/sieve-send-symbolic.svg</file>
  </gresource>
  <gresource prefix="/com/galaxoidlabs/Sieve/icons/scalable/apps">
    <file preprocess="xml-stripblanks" alias="bitcoin-logo.svg">icons/hicolor/scalable/apps/bitcoin-logo.svg</file>
    <!-- The same drawing again under the application id, because that is the
         name the .desktop file and every GNOME surface look for. Until Sieve
         has an icon of its own this is what it wears; a placeholder that is
         findable beats a correct name that resolves to nothing. -->
    <file preprocess="xml-stripblanks" alias="com.galaxoidlabs.Sieve.svg">icons/hicolor/scalable/apps/bitcoin-logo.svg</file>
  </gresource>
</gresources>
